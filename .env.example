# Frontend Environment Variables
# Update this with your deployed backend URL

# For local development (backend running on localhost)
# REACT_APP_API_URL=http://localhost:5000/api

# For production (backend deployed on Render)
REACT_APP_API_URL=https://your-backend.onrender.com/api

# Google Apps Script URL for Contact Form and Reviews
# This is the deployed web app URL from your Google Apps Script
REACT_APP_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# Google Sheets ID for Reviews
# This is the ID from your Google Sheets URL
# Example: https://docs.google.com/spreadsheets/d/SHEET_ID/edit
REACT_APP_GOOGLE_SHEET_ID=YOUR_SHEET_ID_HERE
